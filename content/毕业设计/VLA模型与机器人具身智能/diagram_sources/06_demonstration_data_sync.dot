digraph G {
 graph [rankdir=LR, bgcolor="white", pad="0.25", nodesep="0.25", ranksep="0.35", fontname="Noto Sans CJK SC", labelloc="t", label="一条机器人示范轨迹：必须把观测、状态和动作按时间对齐", fontsize=21];
 node [shape=box, style="rounded,filled", fontname="Noto Sans CJK SC", fontsize=12, color="#607D9A", penwidth=1.3, margin="0.12,0.09"];
 edge [fontname="Noto Sans CJK SC", fontsize=10, color="#516579", penwidth=1.3];
 t0 [label="t₀", fillcolor="#F4F5F7"]; t1 [label="t₁", fillcolor="#F4F5F7"]; t2 [label="t₂", fillcolor="#F4F5F7"]; t3 [label="t₃", fillcolor="#F4F5F7"];
 rgb0 [label="RGB / Depth\n图像帧", fillcolor="#E9F2FF"]; rgb1 [label="RGB / Depth\n图像帧", fillcolor="#E9F2FF"]; rgb2 [label="RGB / Depth\n图像帧", fillcolor="#E9F2FF"]; rgb3 [label="RGB / Depth\n图像帧", fillcolor="#E9F2FF"];
 st0 [label="关节 / 末端\n状态", fillcolor="#E6F5EF"]; st1 [label="关节 / 末端\n状态", fillcolor="#E6F5EF"]; st2 [label="关节 / 末端\n状态", fillcolor="#E6F5EF"]; st3 [label="关节 / 末端\n状态", fillcolor="#E6F5EF"];
 ac0 [label="双臂动作\na₀", fillcolor="#FFF0D9"]; ac1 [label="双臂动作\na₁", fillcolor="#FFF0D9"]; ac2 [label="双臂动作\na₂", fillcolor="#FFF0D9"]; ac3 [label="双臂动作\na₃", fillcolor="#FFF0D9"];
 {rank=same; t0;t1;t2;t3;} {rank=same; rgb0;rgb1;rgb2;rgb3;} {rank=same; st0;st1;st2;st3;} {rank=same; ac0;ac1;ac2;ac3;}
 t0->t1->t2->t3 [style=dashed];
 t0->rgb0; t1->rgb1; t2->rgb2; t3->rgb3;
 rgb0->st0; rgb1->st1; rgb2->st2; rgb3->st3;
 st0->ac0; st1->ac1; st2->ac2; st3->ac3;
}